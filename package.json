{
  "name": "planora-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-planora \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "check:size": "node scripts/check-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:size && npm run check:secrets"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.4",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "firebase-tools": "14.22.0",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.0.13",
    "vitest": "4.1.0",
    "axe-core": "4.10.3"
  },
  "overrides": {
    "playwright-core": "1.62.1",
    "@grpc/grpc-js": "1.14.5"
  }
}
