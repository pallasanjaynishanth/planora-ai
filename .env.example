# Copy to .env.local. Values below are placeholders, not credentials.
# Demo mode is browser-local and never calls Firebase or Gemini.
VITE_APP_MODE=demo
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=YOUR_PUBLIC_RECAPTCHA_SITE_KEY
# Select a currently supported stable text model in your Firebase project.
VITE_GEMINI_MODEL=gemini-3.8-flash
# Local emulators only; production builds reject this flag.
VITE_USE_EMULATORS=false
# Development only; registers a local debug token through Firebase's debug provider.
# Never put a real debug token in this file or a production build.
VITE_APPCHECK_DEBUG=false
